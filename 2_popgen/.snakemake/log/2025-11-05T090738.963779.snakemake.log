        plink --vcf /fs/dss/work/doau0129/hamlet_pheno/phyps2e_m2.vcf.gz --allow-extra-chr --make-bed --out byALL/${prefix}

        # Step 2: Filter for MAF and missingness
        plink --bfile byALL/${prefix} \
              --maf 0.05 --geno 0.05 --allow-extra-chr --make-bed \
              --out byALL/${prefix}.flt

        # Step 3: LD pruning
        plink --bfile byALL/${prefix}.flt \
              --indep-pairwise 50 10 0.2 --allow-extra-chr \
              --out byALL/${prefix}.ld

        plink --bfile byALL/${prefix}.flt \
              --extract byALL/${prefix}.ld.prune.in \
              --allow-extra-chr --make-bed \
              --out byALL/${prefix}.ld.pruned

        # Step 4: Export genotype matrix (transposed)
        plink --bfile byALL/${prefix}.ld.pruned \
              --recode A-transpose --allow-extra-chr \
              --out byALL/${prefix}_ld_pruned_gtmat
        
