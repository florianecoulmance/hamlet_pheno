import os

BASE_DIR="/fs/dss/work/doau0129/hamlet_pheno"  # hamlet_pheno/
GENO_DIR=os.path.join(BASE_DIR, "2_popgen")
SAMPLES_FILE=os.path.join(BASE_DIR, "metadata/geno_names.txt")
VCF_FILE=os.path.join(BASE_DIR, "phyps2e_m2.vcf.gz")

FIGURES_DIR = os.path.join(BASE_DIR, "figures")
SCRIPTS_DIR = os.path.join(BASE_DIR, "scripts")
PYTHON_SCRIPT = os.path.join(SCRIPTS_DIR, "python", "permanova.py")
R_SCRIPT = os.path.join(SCRIPTS_DIR, "R", "Fig3-4_S11-S18.R")

# List of datasets
genotyping_params = [
    # Per location, all species
    {"dataset": "arc"},
    {"dataset": "bar"},
    {"dataset": "bel"},
    {"dataset": "boc"},
    {"dataset": "flk"},
    {"dataset": "gun"},
    {"dataset": "hon"},
    {"dataset": "liz"},
    {"dataset": "pri"},
    {"dataset": "qui"},
    # Overall location (all species combined)
    {"dataset": "all"},
    # Specific species (geo_name = all)
    {"dataset": "abe"},
    {"dataset": "aff"},
    {"dataset": "atl"},
    {"dataset": "chl"},
    {"dataset": "gem"},
    {"dataset": "gum"},
    {"dataset": "gut"},
    {"dataset": "ind"},
    {"dataset": "nig"},
    {"dataset": "pue"},
    {"dataset": "ran"},
    {"dataset": "tan"},
    {"dataset": "uni"},
]

# Separate datasets into "location" and "species" groups
locations = [p["dataset"] for p in genotyping_params if p["dataset"] in
             ["ala","arc","are","bar","bel","boc","flk","gun","hai","hon","liz","pri","qui","san","tam"]]
species = [p["dataset"] for p in genotyping_params if p["dataset"] not in locations + ["all"]]
datasets = locations + species

# Rule to generate all dataset-specific files
rule all:
    input:
        expand("byLOC/{loc}.txt", loc=locations),
        expand("bySPC/{spc}.txt", spc=species),
        expand("byLOC/{loc}.vcf.gz", loc=locations),
        expand("bySPC/{spc}.vcf.gz", spc=species),
        expand("byLOC/{loc}_ld_pruned_gtmat.traw", loc=locations),
        expand("bySPC/{spc}_ld_pruned_gtmat.traw", spc=species),
        "byALL/all_ld_pruned_gtmat.traw",
        "byALL/thinned_all_ld_pruned_gtmat.traw",
        # Location mode outputs in byLOC/permanova_results/
        expand("byLOC/permanova_results/{dataset}.lm.pairwise.csv", dataset=locations),
        # Species mode outputs in bySPC/permanova_results/
        expand("bySPC/permanova_results/{dataset}.sm.pairwise.csv", dataset=species),
        "byALL/permanova_results/all.sm.pairwise.csv",
        "byALL/permanova_results/all.lm.pairwise.csv",
        # Figure outputs
        expand(
            f"{FIGURES_DIR}/{{fig_name}}",
            fig_name=[
                "Fig3_gLocPCA.png",
                "Fig4_gAllPCA.png",
                "FigS11_gAllVAR.png",
                "FigS12_gLocSUP.png",
                "FigS13_gLocPERM.png",
                "FigS14_gAllPERM.png",
                "FigS15_gSpe.png",
                "FigS16_gLocFST.png",
                "FigS17_gAllFST.png",
                "FigS18_gSpeFST.png"
            ]
        )




# --- Create directories ---
rule make_dirs:
    output:
        directory("byLOC"),
        directory("bySPC"),
        directory("byALL")
    shell:
        "mkdir -p {output}"


# Generic rule to extract matching samples
rule split_samples_locations:
    input:
        SAMPLES_FILE
    output:
        "byLOC/{dataset}.txt"
    shell:
        "grep -E '[0-9]{{5}}.*{wildcards.dataset}' {input} > {output} || true"


# Reuse same logic for species
rule split_samples_species:
    input:
        SAMPLES_FILE
    output:
        "bySPC/{dataset}.txt"
    shell:
        "grep -E '[0-9]{{5}}.*{wildcards.dataset}' {input} > {output} || true"


rule subset_vcf:
    input:
        VCF_FILE = VCF_FILE,
        FILTER_FILE = lambda wildcards: (
            f"byLOC/{wildcards.dataset}.txt"
            if wildcards.dataset in locations
            else f"bySPC/{wildcards.dataset}.txt"
        )
    output:
        "by{group}/{dataset}.vcf.gz"
    params:
        group = lambda wildcards: "LOC" if wildcards.dataset in locations else "SPC"
    shell:
        r"""
        module load hpc-env/13.1
        module load BCFtools/1.18-GCC-13.1.0

        bcftools view --threads 4 -S {input.FILTER_FILE} -Oz -o {output} {input.VCF_FILE}
        bcftools index {output}
        """


rule plink_processing:
    input:
        VCF = lambda wildcards: (
            f"byLOC/{wildcards.dataset}.vcf.gz"
            if wildcards.dataset in locations
            else f"bySPC/{wildcards.dataset}.vcf.gz"
        )
    params:
        OUT_DIR = lambda wildcards: (
            "byLOC" if wildcards.dataset in locations else "bySPC"
        )
    output:
        "{OUT_DIR}/{dataset}_ld_pruned_gtmat.traw"
    shell:
        r"""
        module load hpc-env/13.1
        module load PLINK/v1.9b7.4-x86_64

        # Create base prefix (remove folder and extensions)
        prefix=$(basename {input.VCF} .vcf.gz)

        # Step 1: Convert to PLINK binary
        plink --vcf {input.VCF} --allow-extra-chr --make-bed --out $(dirname {input.VCF})/{wildcards.dataset}

        # Step 2: Filter for MAF and missingness
        plink --bfile $(dirname {input.VCF})/{wildcards.dataset} \
              --maf 0.05 --geno 0.05 --allow-extra-chr --make-bed \
              --out $(dirname {input.VCF})/{wildcards.dataset}.flt

        # Step 3: LD pruning
        plink --bfile $(dirname {input.VCF})/{wildcards.dataset}.flt \
              --indep-pairwise 50 10 0.2 --allow-extra-chr \
              --out $(dirname {input.VCF})/{wildcards.dataset}.ld

        plink --bfile $(dirname {input.VCF})/{wildcards.dataset}.flt \
              --extract $(dirname {input.VCF})/{wildcards.dataset}.ld.prune.in \
              --allow-extra-chr --make-bed \
              --out $(dirname {input.VCF})/{wildcards.dataset}.ld.pruned

        # Step 4: Export genotype matrix (transposed)
        plink --bfile $(dirname {input.VCF})/{wildcards.dataset}.ld.pruned \
              --recode A-transpose --allow-extra-chr \
              --out $(dirname {input.VCF})/{wildcards.dataset}_ld_pruned_gtmat
        """


rule run_permanova:
    input:
        GTMAT = lambda wildcards: (
            f"byLOC/{wildcards.dataset}_ld_pruned_gtmat.traw"
            if wildcards.dataset in locations
            else f"bySPC/{wildcards.dataset}_ld_pruned_gtmat.traw"
        ),
        GROUPING = lambda wildcards: (
            f"byLOC/{wildcards.dataset}.txt"
            if wildcards.dataset in locations
            else f"bySPC/{wildcards.dataset}.txt"
        )
    output:
        "{OUTDIR}/{dataset}.{SUFFIX}.pairwise.csv"
    params:
        python_script = PYTHON_SCRIPT,
        OUTDIR = lambda wildcards: (
            f"byLOC/permanova_results/"
            if wildcards.dataset in locations
            else f"bySPC/permanova_results/"
        ),
        MODE_FLAG = lambda wildcards: "-no-s" if wildcards.dataset in locations else "-s",
        SUFFIX = lambda wildcards: (
            "lm" if wildcards.dataset in locations else "sm"
        )
    threads: 1
    shell:
        r"""
        mkdir -p {params.OUTDIR}

        python3 {params.python_script} \
            -i {input.GTMAT} \
            -g {input.GROUPING} \
            -o {params.OUTDIR} \
            {params.MODE_FLAG} \ \
            -n {wildcards.dataset}
        """


rule all_plink:
    input:
        VCF_FILE = VCF_FILE
    output:
        GTMAT = "byALL/all_ld_pruned_gtmat.traw"
    shell:
        r"""
        module load hpc-env/13.1
        module load BCFtools/1.18-GCC-13.1.0
        module load PLINK/v1.9b7.4-x86_64

        # Create index for vcf file
        bcftools index {input.VCF_FILE}

        # Create base prefix (remove folder and extensions)
        prefix="all"

        # Step 1: Convert to PLINK binary
        plink --vcf {input.VCF_FILE} --allow-extra-chr --make-bed --out byALL/${{prefix}}

        # Step 2: Filter for MAF and missingness
        plink --bfile byALL/${{prefix}} \
              --maf 0.05 --geno 0.05 --allow-extra-chr --make-bed \
              --out byALL/${{prefix}}.flt

        # Step 3: LD pruning
        plink --bfile byALL/${{prefix}}.flt \
              --indep-pairwise 50 10 0.2 --allow-extra-chr \
              --out byALL/${{prefix}}.ld

        plink --bfile byALL/${{prefix}}.flt \
              --extract byALL/${{prefix}}.ld.prune.in \
              --allow-extra-chr --make-bed \
              --out byALL/${{prefix}}.ld.pruned

        # Step 4: Export genotype matrix (transposed)
        plink --bfile byALL/${{prefix}}.ld.pruned \
              --recode A-transpose --allow-extra-chr \
              --out byALL/${{prefix}}_ld_pruned_gtmat
        """


rule thin_ld_pruned:
    input:
        LD_PRUNED = "byALL/all_ld_pruned_gtmat.traw"
    output:
        TRIMMED_TRAW = "byALL/thinned_all_ld_pruned_gtmat.traw"
    threads: 4
    shell:
        r"""
        module load hpc-env/13.1
        module load PLINK/v1.9b7.4-x86_64

        # Thin SNPs by distance (200 bp)
        plink --file {input.LD_PRUNED} \
              --thin-dist 200 \
              --recode A-transpose \
              --allow-extra-chr \
              --out byALL/all_ld_pruned_thinned_gtmat

        # Further downsample if desired (e.g., every 500th SNP)
        awk 'NR == 1 || (NR-1) % 500 == 0' \
            byALL/all_ld_pruned_thinned_gtmat.traw \
            > {output.TRIMMED_TRAW}
        """


rule run_permanova_all:
    input:
        GTMAT = "byALL/thinned_all_ld_pruned_gtmat.traw",
        GROUPING = SAMPLES_FILE
    output:
        "byALL/permanova_results/all.lm.pairwise.csv"
        "byALL/permanova_results/all.sm.pairwise.csv"
    params:
        python_script = PYTHON_SCRIPT,
        OUTDIR = "byALL/permanova_results/"
    shell:
        r"""
        python3 {params.python_script} \
            -i {input.GTMAT} \
            -g {input.GROUPING} \
            -o {params.OUTDIR} \
            -no-s \
            -n all


        python3 {params.python_script} \
            -i {input.GTMAT} \
            -g {input.GROUPING} \
            -o {params.OUTDIR} \
            -s \
            -n all
        """


rule pca_plot:
    input:
        gtmat = lambda wildcards: (
            [f"byLOC/{loc}_ld_pruned_gtmat.traw" for loc in locations] +
            [f"bySPC/{spc}_ld_pruned_gtmat.traw" for spc in species] +
            ["byALL/thinned_all_ld_pruned_gtmat.traw"]
        ),
        # PERMANOVA results
        permanova = lambda wildcards: (
            [f"byLOC/permanova_results/{loc}.lm.pairwise.csv" for loc in locations] +
            [f"bySPC/permanova_results/{spc}.sm.pairwise.csv" for spc in species] +
            ["byALL/permanova_results/all.lm.pairwise.csv"] +
            ["byALL/permanova_results/all.sm.pairwise.csv"]
        )
    output:
        f"{FIGURES_DIR}/Fig3_gLocPCA.png",
        f"{FIGURES_DIR}/Fig4_gAllPCA.png",
        f"{FIGURES_DIR}/FigS11_gAllVAR.png",
        f"{FIGURES_DIR}/FigS12_gLocSUP.png",
        f"{FIGURES_DIR}/FigS13_gLocPERM.png",
        f"{FIGURES_DIR}/FigS14_gAllPERM.png",
        f"{FIGURES_DIR}/FigS15_gSpe.png",
        f"{FIGURES_DIR}/FigS16_gLocFST.png",
        f"{FIGURES_DIR}/FigS17_gAllFST.png",
        f"{FIGURES_DIR}/FigS18_gSpeFST.png"
    params:
        base_path = BASE_DIR,
        figure_path = FIGURES_DIR,
        logos_path = f"{BASE_DIR}/metadata/logos_hamlet",
        spec_colors = f"{BASE_DIR}/metadata/species_colors.tsv",
        geo_colors = f"{BASE_DIR}/metadata/locations_colors.tsv"
    threads: 1
    resources:
        mem_mb=2000,
        time="2:00:00"
    shell:
        """
        module load hpc-env/13.1
        module load R/4.3.1-foss-2023a

        Rscript {R_SCRIPT} \
            --base_path {params.base_path} \
            --figure_path {params.figure_path} \
            --logos_path {params.logos_path} \
            --spec_colors {params.spec_colors} \
            --geo_colors {params.geo_colors}
        """

