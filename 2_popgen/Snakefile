        module load R/4.3.1-foss-2023a
        Rscript {SCRIPTS_DIR}/R/FigS22-26.R {params.base_dir} {params.fig_dir}
        """


rule make_ld_bed:
    input:
        GXP_FILE
    output:
        "ld/LD.bed"
    params:
        flank=100000
    shell:
        r"""
        mkdir -p ld/

        awk -v flank={params.flank} 'BEGIN {{OFS="\t"}}
        $1 == "CHROM" {{next}}   # skip header or dummy row
        {{
            start=$2-flank;
            if (start < 1) start=1;
            end=$2+flank;
            print $1, start, end, $1"_"$2
        }}' {input} > {output}
        """


rule vcf_to_plink:
    wildcard_constraints:
        dataset="all|bel|boc|hon|pri|pue|uni|nig|abe"
    input:
        vcf=lambda wc: (
            VCF_FILE if wc.dataset == "all"
            else f"byLOC/{wc.dataset}.vcf.gz" if wc.dataset in locations
            else f"bySPC/{wc.dataset}.vcf.gz"
        ),
    output:
        bed="ld/{dataset}.bed",
        bim="ld/{dataset}.bim",
        fam="ld/{dataset}.fam"
    params:
        prefix="ld/{dataset}"
    shell:
        r"""
        module load hpc-env/13.1
        module load PLINK/v1.9b7.4-x86_64

        plink --vcf {input.vcf} \
              --double-id \
              --allow-extra-chr \
              --make-bed \
              --out {params.prefix}
        """


rule ld_filter:
    wildcard_constraints:
        dataset="all|bel|boc|hon|pri|pue|uni|nig|abe"
    input:
        bed="ld/{dataset}.bed",
        bim="ld/{dataset}.bim",
        fam="ld/{dataset}.fam"
    output:
        bed="ld/{dataset}_filtered.bed",
        bim="ld/{dataset}_filtered.bim",
        fam="ld/{dataset}_filtered.fam"
    params:    
        prefix="ld/{dataset}"
    shell:
        r"""
        module load hpc-env/13.1
        module load PLINK/v1.9b7.4-x86_64

        plink --bfile {params.prefix} \
              --allow-extra-chr \
              --set-missing-var-ids @:# \
              --maf 0.05 \
              --geno 0.05 \
              --make-bed \
              --out {params.prefix}_filtered
        """

rule ld_global:
    wildcard_constraints:
        dataset="all|bel|boc|hon|pri|pue|uni|nig|abe"
    input:
        bed="ld/{dataset}_filtered.bed",
        bim="ld/{dataset}_filtered.bim",
        fam="ld/{dataset}_filtered.fam"
    output:
        ld="ld/{dataset}_global.ld"
    params:
        prefix="ld/{dataset}"
    shell:
        r"""
        module load hpc-env/13.1
        module load PLINK/v1.9b7.4-x86_64

        # enforce spacing
        plink --bfile {params.prefix}_filtered \
              --allow-extra-chr \
              --bp-space 1000000 \
              --make-bed \
              --set-missing-var-ids @:# \
              --out {params.prefix}_1Mb

        # sample 500 SNPs
        cut -f2 {params.prefix}_1Mb.bim | shuf | head -n 500 > {params.prefix}_global.snps

        # compute LD
        plink --bfile {params.prefix}_1Mb \
              --extract {params.prefix}_global.snps \
              --allow-extra-chr \
              --r2 square \
              --out {params.prefix}_global
        """


rule region_snps:
    wildcard_constraints:
        dataset="all|bel|boc|hon|pri|pue|uni|nig|abe"

    input:
        bed="ld/{dataset}_filtered.bed",
        bim="ld/{dataset}_filtered.bim",
        fam="ld/{dataset}_filtered.fam",
        regions="ld/LD.bed"
    output:
        snps="ld/{dataset}.regions.snplist"
    params:
        prefix="ld/{dataset}"
    shell:
        r"""
        module load hpc-env/13.1
        module load PLINK/v1.9b7.4-x86_64

        plink --bfile {params.prefix}_filtered \
              --extract range {input.regions} \
              --allow-extra-chr \
              --set-missing-var-ids @:# \
              --write-snplist \
              --out {params.prefix}.regions
        """


rule ld_regions_all:
    wildcard_constraints:
        dataset="all|bel|boc|hon|pri|pue|uni|nig|abe"

    input:
        bed="ld/{dataset}_filtered.bed",
        bim="ld/{dataset}_filtered.bim",
        fam="ld/{dataset}_filtered.fam",
        snps="ld/{dataset}.regions.snplist"

    output:
        ld="ld/{dataset}.regions.ld"

    params:
        prefix="ld/{dataset}"

    shell:
        r"""
        module load hpc-env/13.1
        module load PLINK/v1.9b7.4-x86_64

        plink --bfile {params.prefix}_filtered \
              --extract {input.snps} \
              --allow-extra-chr \
              --r2 inter-chr \
              --ld-window-r2 0 \
              --out {params.prefix}.regions
        """


rule split_region_ld_full:
    input:
        bed="ld/LD.bed",
        ld="ld/{dataset}.regions.ld"
    output:
        lg04_lg12_1="ld/{dataset}.LG04_LG12_1.ld",
        lg04_lg12_2="ld/{dataset}.LG04_LG12_2.ld",
        lg12_1_lg12_2="ld/{dataset}.LG12_1_LG12_2.ld"
    params:
        prefix="ld/{dataset}"
    shell:
        r"""
        set -euo pipefail

        ############################
        # 1. build regions table
        ############################
        awk 'NR==FNR {{
            chr[$4]=$1;
            start[$4]=$2;
            end[$4]=$3;
            next
        }}
        {{
            split($3,a,":"); chrA=a[1]; posA=a[2]
            split($6,b,":"); chrB=b[1]; posB=b[2]

            regA="NA"; regB="NA"

            for (r in chr) {{
                if (chrA==chr[r] && posA>=start[r] && posA<=end[r]) regA=r
                if (chrB==chr[r] && posB>=start[r] && posB<=end[r]) regB=r
            }}

            if (regA!="NA" && regB!="NA")
                print regA, regB, $0

        }}' {input.bed} {input.ld} > {params.prefix}.tmp.annotated.ld

        ############################
        # 2. split comparisons
        ############################

        awk '
        {{
            a=$1; b=$2;

            if (a > b) {{
                tmp=a; a=b; b=tmp;
            }}

            if ((a ~ /^LG04/ && b=="LG12_20232954") ||
                (a=="LG12_20232954" && b ~ /^LG04/))
                print >> "{output.lg04_lg12_1}"

            else if ((a ~ /^LG04/ && b=="LG12_22227968") ||
                     (a=="LG12_22227968" && b ~ /^LG04/))
                print >> "{output.lg04_lg12_2}"

            else if ((a=="LG12_20232954" && b=="LG12_22227968") ||
                     (a=="LG12_22227968" && b=="LG12_20232954"))
                print >> "{output.lg12_1_lg12_2}"
        }}' {params.prefix}.tmp.annotated.ld

        rm -f {params.prefix}.tmp.annotated.ld
        """

rule plot_ld:
    input:
        expand("ld/{dataset}_global.ld", dataset=ld_datasets),
        expand("ld/{dataset}.LG04_LG12_1.ld", dataset=ld_datasets),
        expand("ld/{dataset}.LG04_LG12_2.ld", dataset=ld_datasets),
        expand("ld/{dataset}.LG12_1_LG12_2.ld", dataset=ld_datasets)
    output:
        f"{FIGURES_DIR}/FigS27_LDboxplots.png"
    params:
        base_dir = BASE_DIR,
        fig_dir = FIGURES_DIR
    shell:
        r"""
        module load R/4.3.1-foss-2023a
        Rscript {SCRIPTS_DIR}/R/FigS27.R {params.base_dir} {params.fig_dir}
        """