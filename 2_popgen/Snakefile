rule newhyb_from_pruned:
    input:
        bed="byLOC/{dataset}.ld.pruned.bed",
        bim="byLOC/{dataset}.ld.pruned.bim",
        fam="byLOC/{dataset}.ld.pruned.fam",
        samples="byLOC/{dataset}.txt"
    output:
        "newhyb/{dataset}/{pair}/done.txt"
    params:
        sp1=lambda wc: wc.pair.split("_")[0],
        sp2=lambda wc: wc.pair.split("_")[1]
    resources:
        mem_mb=10000,
        runtime=720
    shell:
        """
        module load hpc-env/13.1
        module load BCFtools/1.18-GCC-13.1.0
        module load PLINK/v1.9b7.4-x86_64
        module load R/4.3.1-foss-2023a

        set -x

        sp1={params.sp1}
        sp2={params.sp2}

        outdir=newhyb/{wildcards.dataset}/{wildcards.pair}
        mkdir -p $outdir/nh_input

        # count individuals
        # n1=$(grep ${{sp1}}{wildcards.dataset} {input.samples} | wc -l || true)
        # n2=$(grep ${{sp2}}{wildcards.dataset} {input.samples} | wc -l || true)

        n1=$(awk -v sp=${{sp1}} -v loc={wildcards.dataset} '$1 ~ sp && $1 ~ loc {{c++}} END {{print c+0}}' byLOC/{wildcards.dataset}.txt)
        n2=$(awk -v sp=${{sp2}} -v loc={wildcards.dataset} '$1 ~ sp && $1 ~ loc {{c++}} END {{print c+0}}' byLOC/{wildcards.dataset}.txt)

        if [ ${{n1}} -lt 5 ] || [ ${{n2}} -lt 5 ]; then
            echo "Skipping ${{sp1}}-${{sp2}} (low N)"
            touch {output}
            exit 0
        fi

        echo "Running ${{sp1}} vs ${{sp2}}"
        
        # create keep file (plink format: FID IID)
        awk -v s1=${{sp1}} -v s2=${{sp2}} -v loc={wildcards.dataset} \
            '($1 ~ s1 && $1 ~ loc) || ($1 ~ s2 && $1 ~ loc) {{print $1, $1}}' \
            {input.samples} > $outdir/keep.txt

        # subset PLINK dataset
        plink \
            --bfile byLOC/{wildcards.dataset}.ld.pruned \
            --keep $outdir/keep.txt \
            --allow-extra-chr \
            --recode vcf-iid bgz \
            --out $outdir/data

        # compress VCF
        bcftools index $outdir/data.vcf.gz

        # subsample SNPs (fast + simple)
        bcftools view -H $outdir/data.vcf.gz | shuf -n 200 | cut -f1,2 > $outdir/snps.txt

        bcftools view -R $outdir/snps.txt $outdir/data.vcf.gz -Oz -o $outdir/data.subset.vcf.gz
        bcftools index $outdir/data.subset.vcf.gz

        nind_vcf=$(bcftools query -l $outdir/data.subset.vcf.gz | wc -l)

        if [ "$nind_vcf" -eq 0 ]; then
            echo "No individuals left after filtering for ${{sp1}}-${{sp2}}"
            touch {output}
            exit 0
        fi

        # count SNPs: can comment since we thin the data
        # nsnps=$(bcftools view -H $outdir/data.vcf.gz | wc -l)
        # echo -e "{wildcards.dataset}\t${{sp1}}\t${{sp2}}\t${{nsnps}}" >> newhyb/snp_counts.tsv

        # genotype conversion
        bcftools query -f '%CHROM:%POS[\\t%GT]\\n' $outdir/data.subset.vcf.gz > $outdir/tmp.geno

        # count
        nloc=$(wc -l < $outdir/tmp.geno)
        nind=$(head -n1 $outdir/tmp.geno | awk '{{print NF-1}}')
                    
        # header
        echo "NumIndivs ${{nind}}" > $outdir/nh_input/input.txt
        echo "NumLoci ${{nloc}}" >> $outdir/nh_input/input.txt
        echo "Digits 1" >> $outdir/nh_input/input.txt
        echo "Format Lumped" >> $outdir/nh_input/input.txt
                    
        # locus names
        awk '{{printf "SNP_%d ", NR}} END {{printf "\\n"}}' $outdir/tmp.geno | \
        sed '1s/^/LocusNames /' >> $outdir/nh_input/input.txt
        
        # transpose + recode
        awk '{{
            for(i=2; i<=NF; i++) {{
                g=$i;
                if(g=="0/0") v="11";
                else if(g=="0/1" || g=="1/0") v="12";
                else if(g=="1/1") v="22";
                else v="0";
                matrix[i-1,NR]=v;
                if(i-1 > max_ind) max_ind=i-1;
            }}
        }}
        END {{
            for(i=1; i<=max_ind; i++) {{
                printf "%d", i;
                for(j=1; j<=NR; j++) {{
                    printf " %s", matrix[i,j];
                }}
                printf "\\n";
            }}
        }}' $outdir/tmp.geno >> $outdir/nh_input/input.txt


        bcftools query -l $outdir/data.subset.vcf.gz > $outdir/nh_input/individuals.txt


        # run NewHybrids
        Rscript {SCRIPTS_DIR}/R/newhybrids.R $outdir/nh_input/

        touch {output}
        """


rule plot_newhybrids:
    input:
        expand("newhyb/{dataset}/{pair}/done.txt",
               dataset=locations,
               pair=PAIRS)
    output:
        fig = f"{FIGURES_DIR}/FigS20_newhybrid.png"
    params:
        base_dir = BASE_DIR,
        fig_dir = FIGURES_DIR
    shell:
        r"""
        module load R/4.3.1-foss-2023a
        Rscript {SCRIPTS_DIR}/R/FigS20.R {params.base_dir} {params.fig_dir}
        """


rule make_ld_bed:
    input:
        GXP_FILE
    output:
        "ld/LD.bed"
    params:
        flank=250000
    shell:
        r"""
        awk -v flank={params.flank} 'BEGIN {{OFS="\t"}}
        $1 == "CHROM" {{next}}   # skip header or dummy row
        {{
            start=$2-flank;
            if (start < 1) start=1;
            end=$2+flank;
            print $1, start, end, $1"_"$2
        }}' {input} > {output}
        """


rule compute_ild:
    input:
        vcf=lambda wc: (
            VCF_FILE if wc.dataset == "all"
            else f"byLOC/{wc.dataset}.vcf.gz" if wc.dataset in locations
            else f"bySPC/{wc.dataset}.vcf.gz"
        ),
        bed="ld/LD.bed"
    output:
        "ld/{dataset}_ILD.ld"
    params:
        tmp_prefix="ld/{dataset}_plink"
    shell:
        r"""
        module load hpc-env/13.1
        module load PLINK/v1.9b7.4-x86_64

        # 1. Convert VCF → PLINK
        plink --vcf {input.vcf} \
              --double-id \
              --allow-extra-chr \
              --make-bed \
              --out {params.tmp_prefix}

        # 2. Compute LD only in regions of interest
        plink --bfile {params.tmp_prefix} \
              --allow-extra-chr \
              --extract range {input.bed} \
              --r2 \
              --ld-window-kb 1000 \
              --ld-window 99999 \
              --ld-window-r2 0 \
              --out ld/{wildcards.dataset}_ILD
        """

rule ld_LG12_between:
    input:
        vcf=lambda wc: (
            VCF_FILE if wc.dataset == "all"
            else f"byLOC/{wc.dataset}.vcf.gz" if wc.dataset in locations
            else f"bySPC/{wc.dataset}.vcf.gz"
        )
    output:
        "ld/{dataset}_LG12_12.ld"
    params:
        tmp_vcf="ld/{dataset}_LG12.vcf.gz",
        tmp_prefix="ld/{dataset}_LG12"
    shell:
        r"""
        module load hpc-env/13.1
        module load BCFtools/1.18-GCC-13.1.0
        module load PLINK/v1.9b7.4-x86_64

        bcftools view -r LG12:19982954-20482954,LG12:21977968-22477968 -Oz -o {params.tmp_vcf} {input.vcf}
        bcftools index {params.tmp_vcf}

        plink --vcf {params.tmp_vcf} \
              --allow-extra-chr \
              --make-bed \
              --out {params.tmp_prefix}

        plink --bfile {params.tmp_prefix} \
              --allow-extra-chr \
              --r2 \
              --ld-window-kb 5000 \
              --ld-window 99999 \
              --ld-window-r2 0 \
              --out ld/{wildcards.dataset}_LG12_12
        """