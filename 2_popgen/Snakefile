# Separate datasets into "location" and "species" groups
locations = ["arc","bar","bel","boc","flk","gun","hon","liz","pri","qui"]
species = ["abe","aff","atl","chl","gem","gum","gut","ind","nig","pue","ran","tan","uni","may"]
plink_species = [s for s in species if s != "may"]
print(plink_species)
datasets = locations + ["all"] #+ species
PAIRS = [f"{a}_{b}" for i,a in enumerate(species) for b in species[i+1:]]
ld_datasets = ["all", "bel", "boc", "hon", "pri", "pue", "uni", "nig", "abe"]

# Rule to generate all dataset-specific files
rule all:
    input:
        expand("byLOC/{loc}.txt", loc=locations),
        expand("bySPC/{spc}.txt", spc=plink_species),
        expand("byLOC/{loc}.vcf.gz", loc=locations),
        expand("bySPC/{spc}.vcf.gz", spc=plink_species),
