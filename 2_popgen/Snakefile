rule newhyb_from_fst:
    input:
        VCF_FILE = VCF_FILE,
        samples="byLOC/{dataset}.txt"
    output:
        "newhyb/{dataset}/{pair}/done.txt"
    params:
        sp1=lambda wc: wc.pair.split("_")[0],
        sp2=lambda wc: wc.pair.split("_")[1]
    resources:
        mem_mb=10000,
        runtime=720
    shell:
        """
        module load hpc-env/13.1
        module load BCFtools/1.18-GCC-13.1.0
        module load PLINK/v1.9b7.4-x86_64
        module load VCFtools/0.1.16-GCC-13.1.0
        module load R/4.3.1-foss-2023a

        set -x

        sp1={params.sp1}
        sp2={params.sp2}

        outdir=newhyb/{wildcards.dataset}/{wildcards.pair}
        # mkdir -p $outdir/nh_input

        # count individuals
        n1=$(awk -v sp=${{sp1}} -v loc={wildcards.dataset} '$1 ~ sp && $1 ~ loc {{c++}} END {{print c+0}}' byLOC/{wildcards.dataset}.txt)
        n2=$(awk -v sp=${{sp2}} -v loc={wildcards.dataset} '$1 ~ sp && $1 ~ loc {{c++}} END {{print c+0}}' byLOC/{wildcards.dataset}.txt)

        if [ ${{n1}} -lt 5 ] || [ ${{n2}} -lt 5 ]; then
            echo "Skipping ${{sp1}}-${{sp2}} (low N)"
            touch {output}
            exit 0
        fi

        echo "Running ${{sp1}} vs ${{sp2}}"
        
        # create keep file (plink format: FID IID)
        awk -v s1=${{sp1}} -v s2=${{sp2}} -v loc={wildcards.dataset} \
            '($1 ~ s1 && $1 ~ loc) || ($1 ~ s2 && $1 ~ loc) {{print $1}}' \
            {input.samples} > $outdir/keep.txt
        
        # subset for pairs from overall dataset
        bcftools view --threads 4 -S $outdir/keep.txt -Oz -o $outdir/pair.vcf.gz {input.VCF_FILE}

        #convert to binary
        plink --vcf $outdir/pair.vcf.gz --allow-extra-chr --double-id --make-bed --out $outdir/pair

        # light filtering on the subset
        plink \
            --bfile $outdir/pair \
            --geno 0.05 \
            --maf 0.01 \
            --allow-extra-chr \
            --recode vcf-iid bgz \
            --out $outdir/data

        # compress VCF
        bcftools index $outdir/data.vcf.gz

        # create pop file for both species in the pair
        awk -v s=${{sp1}} '$1 ~ s {{print $1}}' $outdir/keep.txt > $outdir/pop1.txt
        awk -v s=${{sp2}} '$1 ~ s {{print $1}}' $outdir/keep.txt > $outdir/pop2.txt

        # compute fsts/snps for the species pair
        vcftools --gzvcf $outdir/data.vcf.gz \
                 --weir-fst-pop $outdir/pop1.txt \
                 --weir-fst-pop $outdir/pop2.txt \
                 --out $outdir/fst

        # tail -n +2 $outdir/fst.weir.fst | sort -k3,3gr | head -n 800 | cut -f1,2 | shuf -n 80 > $outdir/snps.txt.tmp
        
        # 1. Remove header
        tail -n +2 $outdir/fst.weir.fst > $outdir/fst.noheader.txt

        # 2. Sort by FST (column 3)
        sort -k3,3gr $outdir/fst.noheader.txt > $outdir/fst.sorted.txt

        # 3. Take top 800 SNPs
        head -n 800 $outdir/fst.sorted.txt > $outdir/fst.top800.txt

        # 4. Keep only CHROM and POS
        cut -f1,2 $outdir/fst.top800.txt > $outdir/fst.top800.pos.txt

        # 5. Randomly sample 80 SNPs
        shuf $outdir/fst.top800.pos.txt | head -n 80 > $outdir/snps.txt
        
        # mv $outdir/snps.txt.tmp $outdir/snps.txt
        
        touch {output}
        """

rule newhyb_from_snps:
    input:
        VCF_FILE = VCF_FILE,
        snps="newhyb/{dataset}/{pair}/done.txt"
    output:
        "newhyb/{dataset}/{pair}/done1.txt"
    params:
        sp1=lambda wc: wc.pair.split("_")[0],
        sp2=lambda wc: wc.pair.split("_")[1]
    resources:
        mem_mb=10000,
        runtime=720
    shell:
        """
        module load hpc-env/13.1
        module load BCFtools/1.18-GCC-13.1.0
        module load R/4.3.1-foss-2023a

        set -x

        sp1={params.sp1}
        sp2={params.sp2}

        outdir=newhyb/{wildcards.dataset}/{wildcards.pair}/
        mkdir -p $outdir/nh_input/

        # count individuals
        n1=$(awk -v sp=${{sp1}} -v loc={wildcards.dataset} '$1 ~ sp && $1 ~ loc {{c++}} END {{print c+0}}' byLOC/{wildcards.dataset}.txt)
        n2=$(awk -v sp=${{sp2}} -v loc={wildcards.dataset} '$1 ~ sp && $1 ~ loc {{c++}} END {{print c+0}}' byLOC/{wildcards.dataset}.txt)

        if [ ${{n1}} -lt 5 ] || [ ${{n2}} -lt 5 ]; then
            echo "Skipping ${{sp1}}-${{sp2}} (low N)"
            touch {output}
            exit 0
        fi

        echo "Running ${{sp1}} vs ${{sp2}}"       
        
        bcftools view -R $outdir/snps.txt $outdir/data.vcf.gz -Oz -o $outdir/data.80subset.vcf.gz
        bcftools index $outdir/data.80subset.vcf.gz

        nind_vcf=$(bcftools query -l $outdir/data.80subset.vcf.gz | wc -l)

        if [ "$nind_vcf" -eq 0 ]; then
            echo "No individuals left after filtering for ${{sp1}}-${{sp2}}"
            touch {output}
            exit 0
        fi

        # genotype conversion
        bcftools query -f '%CHROM:%POS[\\t%GT]\\n' $outdir/data.80subset.vcf.gz > $outdir/tmp.geno

        # count
        nloc=$(wc -l < $outdir/tmp.geno)
        nind=$(head -n1 $outdir/tmp.geno | awk '{{print NF-1}}')
                    
        # header
        echo "NumIndivs ${{nind}}" > $outdir/nh_input/input.txt
        echo "NumLoci ${{nloc}}" >> $outdir/nh_input/input.txt
        echo "Digits 1" >> $outdir/nh_input/input.txt
        echo "Format Lumped" >> $outdir/nh_input/input.txt
                    
        # locus names
        awk '{{printf "SNP_%d ", NR}} END {{printf "\\n"}}' $outdir/tmp.geno | \
        sed '1s/^/LocusNames /' >> $outdir/nh_input/input.txt
        
        # transpose + recode
        awk '{{
            for(i=2; i<=NF; i++) {{
                g=$i;
                if(g=="0/0") v="11";
                else if(g=="0/1" || g=="1/0") v="12";
                else if(g=="1/1") v="22";
                else v="0";
                matrix[i-1,NR]=v;
                if(i-1 > max_ind) max_ind=i-1;
            }}
        }}
        END {{
            for(i=1; i<=max_ind; i++) {{
                printf "%d", i;
                for(j=1; j<=NR; j++) {{
                    printf " %s", matrix[i,j];
                }}
                printf "\\n";
            }}
        }}' $outdir/tmp.geno >> $outdir/nh_input/input.txt


        bcftools query -l $outdir/data.80subset.vcf.gz > $outdir/nh_input/individuals.txt


        # run NewHybrids
        Rscript {SCRIPTS_DIR}/R/newhybrids.R $outdir/nh_input/

        touch {output}
        """


rule plot_newhybrids:
    input:
